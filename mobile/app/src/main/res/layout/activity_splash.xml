<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SplashActivity"
    android:gravity="center" android:orientation="vertical">
    <ImageView android:src="@drawable/ic_launcher_foreground"
        android:layout_height="100dp" android:layout_width="100dp"/>
    <TextView android:text="Grocery App" android:textSize="20sp"
        android:layout_height="80dp" android:layout_width="100dp"/>
</LinearLayout>

