@model GroceryWebApp.Models.Dto.WarehouseDto
@{
    ViewData["Title"] = "Create Warehouse";
}

<div class="container mt-5">
    <h2 class="mb-4">Create New Warehouse</h2>

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="WarehouseName" class="form-label">Warehouse Name</label>
            <input asp-for="WarehouseName" class="form-control" />
            <span asp-validation-for="WarehouseName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="WarehouseLocation" class="form-label">Location</label>
            <input asp-for="WarehouseLocation" class="form-control" />
            <span asp-validation-for="WarehouseLocation" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-link">Back to List</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
