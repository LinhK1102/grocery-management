@model WebApplication.Models.Dto.WarehouseDto
@{
    ViewData["Title"] = "Create Warehouse";
}

<h2 class="text-2xl font-bold mb-4">Create New Warehouse</h2>

<form asp-action="Create" method="post" class="space-y-4">
    <div>
        <label asp-for="WarehouseName" class="block font-medium">Name</label>
        <input asp-for="WarehouseName" class="form-input w-full border rounded px-3 py-2" />
        <span asp-validation-for="WarehouseName" class="text-red-500 text-sm"></span>
    </div>

    <div>
        <label asp-for="WarehouseLocation" class="block font-medium">Location</label>
        <input asp-for="WarehouseLocation" class="form-input w-full border rounded px-3 py-2" />
        <span asp-validation-for="WarehouseLocation" class="text-red-500 text-sm"></span>
    </div>

    <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Create</button>
    <a asp-action="Index" class="ml-4 text-gray-600 hover:underline">Back to List</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
