@model List<WebApplication.Models.Dto.WarehouseDto>
@{
    ViewData["Title"] = "Warehouse List";
}

<h2 class="text-2xl font-bold mb-4">Warehouses</h2>

<a class="bg-blue-600 text-white px-4 py-2 rounded inline-block mb-4" href="@Url.Action("Create")">+ Add Warehouse</a>

<table class="min-w-full bg-white border border-gray-200 shadow-md rounded">
    <thead class="bg-gray-100">
        <tr>
            <th class="px-4 py-2">ID</th>
            <th class="px-4 py-2">Name</th>
            <th class="px-4 py-2">Location</th>
            <th class="px-4 py-2">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var w in Model)
        {
            <tr class="border-t hover:bg-gray-50">
                <td class="px-4 py-2">@w.WarehouseId</td>
                <td class="px-4 py-2">@w.WarehouseName</td>
                <td class="px-4 py-2">@w.WarehouseLocation</td>
                <td class="px-4 py-2">
                    <a class="text-blue-600 hover:underline" href="@Url.Action("Edit", new { id = w.WarehouseId })">Edit</a> |
                    <form asp-action="DeleteConfirmed" asp-route-id="@w.WarehouseId" method="post" class="inline">
                        <button type="submit" class="text-red-600 hover:underline bg-transparent border-none p-0 m-0">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
