@model List<WebApplication.Models.Dto.WarehouseDto>
@{
    ViewData["Title"] = "Warehouse List";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Warehouse List</h2>
        <a href="@Url.Action("Create")" class="btn btn-success">+ Create New</a>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Location</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in Model)
            {
                <tr>
                    <td>@w.WarehouseId</td>
                    <td>@w.WarehouseName</td>
                    <td>@w.WarehouseLocation</td>
                    <td>
                        <a href="@Url.Action("Edit", new { id = w.WarehouseId })" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                        <form asp-action="DeleteConfirmed" asp-route-id="@w.WarehouseId" method="post" class="d-inline" onsubmit="return confirm('Are you sure?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
