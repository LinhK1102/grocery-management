@model GroceryWebApp.Models.Dto.WarehouseDto
@{
    ViewData["Title"] = "Edit Warehouse";
}

<div class="container mt-5">
    <h2 class="mb-4">Edit Warehouse</h2>

    <form asp-action="Edit" asp-route-id="@Model.WarehouseId" method="post">
        <input type="hidden" asp-for="WarehouseId" />

        <div class="mb-3">
            <label asp-for="WarehouseName" class="form-label">Name</label>
            <input asp-for="WarehouseName" class="form-control" />
            <span asp-validation-for="WarehouseName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="WarehouseLocation" class="form-label">Location</label>
            <input asp-for="WarehouseLocation" class="form-control" />
            <span asp-validation-for="WarehouseLocation" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
