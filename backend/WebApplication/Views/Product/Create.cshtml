@model GroceryWebApp.Models.Dto.ProductDto
@{
    ViewData["Title"] = "Create Product";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container mt-4">
    <h2 class="mb-4"><i class="fas fa-box-open me-2 text-primary"></i>Create Product</h2>

    <div class="card shadow-lg rounded-4 border-0">
        <div class="card-body p-4">
            <form asp-action="Create" method="post" novalidate>
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="row g-4">
                    <!-- Left column -->
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="ProductName" class="form-control rounded-3" placeholder="Product Name" />
                            <label asp-for="ProductName"><i class="fas fa-tag me-2 text-muted"></i>Product Name</label>
                            <span asp-validation-for="ProductName" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mt-3">
                            <select asp-for="CategoryId" class="form-select rounded-3" asp-items="@(ViewBag.Categories as List<SelectListItem>)">
                                <option value="">-- Select Category --</option>
                            </select>
                            <label asp-for="CategoryId"><i class="fas fa-layer-group me-2 text-muted"></i>Category</label>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mt-3">
                            <select asp-for="SupplierId" class="form-select rounded-3" asp-items="@(ViewBag.Suppliers as List<SelectListItem>)">
                                <option value="">-- Select Supplier --</option>
                            </select>
                            <label asp-for="SupplierId"><i class="fas fa-truck me-2 text-muted"></i>Supplier</label>
                            <span asp-validation-for="SupplierId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Right column -->
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="UnitsInStock" class="form-control rounded-3" readonly value="0" placeholder="0" />
                            <label asp-for="UnitsInStock"><i class="fas fa-boxes-stacked me-2 text-muted"></i>Units In Stock</label>
                            <span asp-validation-for="UnitsInStock" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mt-3">
                            <input asp-for="UnitPrice" class="form-control rounded-3" placeholder="Price" />
                            <label asp-for="UnitPrice"><i class="fas fa-dollar-sign me-2 text-muted"></i>Unit Price</label>
                            <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mt-3">
                            <input asp-for="BarcodeValue" class="form-control rounded-3" placeholder="Barcode" />
                            <label asp-for="BarcodeValue"><i class="fas fa-barcode me-2 text-muted"></i>Barcode</label>
                            <span asp-validation-for="BarcodeValue" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mt-3">
                            <input asp-for="ExpiryDuration" type="date" class="form-control rounded-3" placeholder="Expiry Date" />
                            <label asp-for="ExpiryDuration"><i class="fas fa-calendar-day me-2 text-muted"></i>Expiry Duration</label>
                            <span asp-validation-for="ExpiryDuration" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-primary rounded-3 px-4">
                        <i class="fas fa-check me-1"></i>Create
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4 ms-2">
                        <i class="fas fa-arrow-left me-1"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
