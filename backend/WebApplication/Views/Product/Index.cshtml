@{
    ViewData["Title"] = "Create Order / Invoice";
    var products = ViewBag.Products as List<dynamic> ?? new List<dynamic>();
}

<h2 class="mb-4">Create Order</h2>

<form id="order-form" method="post">
    <div class="mb-3">
        <label for="CustomerName" class="form-label">Customer Name</label>
        <input id="CustomerName" name="CustomerName" class="form-control" />
    </div>

    <div class="mb-3">
        <label for="OrderDate" class="form-label">Order Date</label>
        <input id="OrderDate" name="OrderDate" type="date" class="form-control" />
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label for="barcodeInput" class="form-label">Scan Barcode</label>
            <input type="text" id="barcodeInput" class="form-control" placeholder="Enter or scan barcode" autofocus />
        </div>

        <div class="col-md-4">
            <label for="productSelect" class="form-label">Select Product</label>
            <select id="productSelect" class="form-select">
                <option value="">-- Select Product --</option>
                @foreach (var p in products)
                {
                    <option value="@p.ProductId" data-name="@p.ProductName" data-price="@p.UnitPrice" data-barcode="@p.Barcode">
                        @p.ProductName
                    </option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label for="quantityInput" class="form-label">Quantity</label>
            <input type="number" id="quantityInput" class="form-control" min="1" value="1" />
        </div>

        <div class="col-md-2 d-grid">
            <label class="form-label invisible">Add</label>
            <button type="button" class="btn btn-primary" onclick="addProduct()">
                <i class="fas fa-plus"></i> Add
            </button>
        </div>
    </div>

    <h4>Order Items</h4>
    <table class="table table-bordered" id="orderTable">
        <thead class="table-light">
            <tr>
                <th>Product</th>
                <th style="width: 120px;">Qty</th>
                <th style="width: 150px;">Unit Price</th>
                <th style="width: 80px;"></th>
            </tr>
        </thead>
        <tbody id="order-items"></tbody>
    </table>

    <div class="mt-4 d-flex gap-3">
        <button type="submit" name="isBanking" value="true" class="btn btn-success">
            <i class="fas fa-qrcode"></i> Pay with QR
        </button>

        <button type="submit" name="isBanking" value="false" class="btn btn-secondary">
            <i class="fas fa-receipt"></i> Create Order Only
        </button>
    </div>
</form>

@section Scripts {
    <script>
        const barcodeInput = document.getElementById("barcodeInput");
        const productSelect = document.getElementById("productSelect");
        const quantityInput = document.getElementById("quantityInput");
        const orderItems = document.getElementById("order-items");

        // Add product to table
        function addProduct() {
            const productId = productSelect.value;
            if (!productId || parseInt(quantityInput.value) < 1) return;

            const selectedOption = productSelect.options[productSelect.selectedIndex];
            const productName = selectedOption.text;
            const unitPrice = parseFloat(selectedOption.dataset.price || 0);
            const quantity = parseInt(quantityInput.value);

            const index = orderItems.children.length;

            const row = document.createElement("tr");
            row.innerHTML = `
                <td>
                    <input type="hidden" name="Items[${index}].ProductId" value="${productId}" />
                    ${productName}
                </td>
                <td>
                    <input type="number" name="Items[${index}].Quantity" value="${quantity}" class="form-control" />
                </td>
                <td>
                    <input type="number" name="Items[${index}].UnitPrice" value="${unitPrice}" class="form-control" step="0.01" />
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-danger remove-btn">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </td>
            `;
            orderItems.appendChild(row);

            // reset input
            productSelect.value = "";
            quantityInput.value = 1;
            barcodeInput.value = "";
            barcodeInput.focus();
        }

        // Remove row using event delegation
        orderItems.addEventListener("click", function (e) {
            if (e.target.closest(".remove-btn")) {
                e.target.closest("tr").remove();
            }
        });

        // Auto-select product by barcode
        barcodeInput.addEventListener("input", () => {
            const barcode = barcodeInput.value.trim();
            const options = productSelect.options;
            for (let i = 0; i < options.length; i++) {
                if (options[i].dataset.barcode === barcode) {
                    productSelect.selectedIndex = i;
                    break;
                }
            }
        });
    </script>
}
