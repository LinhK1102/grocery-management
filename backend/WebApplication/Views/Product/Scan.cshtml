@{
    ViewData["Title"] = "Scan Barcode";
}

<h2 class="text-primary mb-4"><i class="fas fa-barcode me-2"></i>Scan Barcode</h2>

<div class="row">
    <div class="col-md-6">
        <div id="reader" style="width: 100%;"></div>
    </div>

    <div class="col-md-6">
        <div class="card border-success p-3">
            <h5 class="text-success"><i class="fas fa-check-circle me-2"></i>Scanned Result</h5>
            <div id="result" class="fs-4 fw-bold text-break text-dark"></div>

            <form id="barcodeForm" asp-action="HandleBarcode" method="post" class="mt-3">
                <input type="hidden" name="barcodeValue" id="barcodeInput" />
                <button type="submit" class="btn btn-success px-4 mt-2" disabled id="submitBtn">
                    <i class="fas fa-paper-plane me-1"></i>Submit Barcode
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <script>
        function onScanSuccess(decodedText, decodedResult) {
            console.log(`Code matched = ${decodedText}`, decodedResult);
            document.getElementById("result").innerText = decodedText;
            document.getElementById("barcodeInput").value = decodedText;
            document.getElementById("submitBtn").disabled = false;

            // Optional: stop scanning after successful read
            html5QrcodeScanner.clear();
        }

        const html5QrcodeScanner = new Html5QrcodeScanner(
            "reader", { fps: 10, qrbox: 250 });
        html5QrcodeScanner.render(onScanSuccess);
    </script>
}
