@model WebApplication.Models.Dto.ProductDto
@{
    if (Model == null)
    {
        <partial name="_NotFoundPartial" />
        return;
    }

    ViewData["Title"] = "Product Details";
}

<div class="card shadow-lg border-0 mt-4">
    <div class="card-header bg-primary text-white">
        <h4>@Model.ProductName</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Product ID</dt>
            <dd class="col-sm-9">@Model.ProductId</dd>

            <dt class="col-sm-3">Category ID</dt>
            <dd class="col-sm-9">@Model.CategoryId</dd>

            <dt class="col-sm-3">Supplier ID</dt>
            <dd class="col-sm-9">@Model.SupplierId</dd>

            <dt class="col-sm-3">Units in Stock</dt>
            <dd class="col-sm-9">@Model.UnitsInStock</dd>

            <dt class="col-sm-3">Unit Price</dt>
            <dd class="col-sm-9">@Model.UnitPrice</dd>

            <dt class="col-sm-3">Barcode</dt>
            <dd class="col-sm-9">@Model.BarcodeValue</dd>

            <dt class="col-sm-3">Expiry</dt>
            <dd class="col-sm-9">@Model.ExpiryDuration.ToString("yyyy-MM-dd")</dd>
        </dl>
        <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
