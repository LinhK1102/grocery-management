@model GroceryWebApp.Models.Dto.ProductDetailDto
@using GroceryWebApp.Helpers

@{
    if (Model == null)
    {
        <partial name="_NotFoundPartial" />
        return;
    }

    ViewData["Title"] = "Product Details";
    var icon = DtoExtensions.GetIconClass(Model.Category?.CategoryName ?? "");
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container my-5">
    <!-- Header & Actions -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-primary"><i class="bi bi-box-seam"></i> Product Details</h2>
            <p class="text-muted mb-0">Detailed product and stock information</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-dark">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
            <a asp-controller="Items" asp-action="Create" asp-route-productId="@Model.ProductId" class="btn btn-outline-success">
                Add Item
            </a>
            <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i> Edit Product
            </a>
        </div>
    </div>

    <!-- Product Info -->
    <div class="row g-4">
        <!-- Left: Info -->
        <div class="col-lg-5">
            <div class="card shadow border-0">
                <div class="card-header bg-light d-flex align-items-center">
                    <i class="bi bi-info-circle text-primary fs-5 me-2"></i>
                    <h5 class="mb-0">Product Information</h5>
                </div>
                <div class="card-body">
                    <!-- Category Info -->
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px;">
                            <i class="fa-solid @icon fa-lg text-secondary"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">Category</div>
                            <div class="text-muted">@Model.Category?.CategoryName</div>
                        </div>
                    </div>

                    <dl class="row mb-3">
                        <dt class="col-sm-5">Product Name</dt>
                        <dd class="col-sm-7 fw-semibold">@Model.ProductName</dd>

                        <dt class="col-sm-5">Product ID</dt>
                        <dd class="col-sm-7">#@Model.ProductId</dd>

                        <dt class="col-sm-5">Barcode</dt>
                        <dd class="col-sm-7">@Model.BarcodeValue</dd>

                        <dt class="col-sm-5">Expiry Date</dt>
                        <dd class="col-sm-7">@Model.ExpiryDuration.ToString("yyyy-MM-dd")</dd>
                    </dl>

                    <h6 class="text-muted mt-4 mb-2">Stock & Supplier</h6>
                    <dl class="row">
                        <dt class="col-sm-5">Units in Stock</dt>
                        <dd class="col-sm-7">@Model.UnitsInStock</dd>

                        <dt class="col-sm-5">Unit Price</dt>
                        <dd class="col-sm-7">@Model.UnitPrice.ToString("C")</dd>

                        <dt class="col-sm-5">Supplier</dt>
                        <dd class="col-sm-7">@Model.Supplier?.SupplierName</dd>

                        <dt class="col-sm-5">Contact</dt>
                        <dd class="col-sm-7">
                            <div>@Model.Supplier?.SupplierEmail</div>
                            <div>@Model.Supplier?.SupplierPhoneNumber</div>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Right: Items -->
        <div class="col-lg-7">
            <div class="card shadow border-0 h-100">
                <div class="card-header bg-light d-flex align-items-center">
                    <i class="bi bi-list-check text-success fs-5 me-2"></i>
                    <h5 class="mb-0">Product Items</h5>
                </div>
                <div class="card-body table-responsive" style="max-height: 450px; overflow-y: auto;">
                    @if (Model.Items?.Any() == true)
                    {
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Batch</th>
                                    <th>Barcode</th>
                                    <th>Qty</th>
                                    <th>Expiry</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.BatchCode</td>
                                        <td>@item.Barcode</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.ExpiryDate.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted fst-italic">No item details available.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
