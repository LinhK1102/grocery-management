@model List<GroceryWebApp.Models.Dto.InvoiceDto>
@{
    ViewData["Title"] = "Invoices";
}

<h2 class="text-2xl font-bold mb-4">Invoice List</h2>

<table class="min-w-full bg-white border border-gray-200 shadow-md rounded">
    <thead class="bg-gray-100">
        <tr>
            <th class="px-4 py-2">Invoice ID</th>
            <th class="px-4 py-2">Date</th>
            <th class="px-4 py-2">Customer</th>
            <th class="px-4 py-2">File</th>
            <th class="px-4 py-2">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var invoice in Model)
        {
            <tr class="border-t hover:bg-gray-50">
                <td class="px-4 py-2">@invoice.InvoiceId</td>
                <td class="px-4 py-2">@invoice.CreatedDate.ToString("yyyy-MM-dd")</td>
                <td class="px-4 py-2">@invoice.CustomerName</td>
                <td class="px-4 py-2">
                    @if (!string.IsNullOrEmpty(invoice.InvoiceFilePath))
                    {
                        <a href="@invoice.InvoiceFilePath" target="_blank" class="text-blue-600 hover:underline">Download</a>
                    }
                </td>
                <td class="px-4 py-2">
                    <a href="@Url.Action("Details", new { id = invoice.InvoiceId })" class="text-blue-600 hover:underline">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
