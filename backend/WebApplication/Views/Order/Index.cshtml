@model List<GroceryWebApp.Models.Dto.OrderDto>
@{
    ViewData["Title"] = "Orders";
}

<h2 class="mb-4 fw-bold fs-4"><i class="fas fa-list-alt me-2"></i>Order List</h2>

<div class="table-responsive shadow rounded border">
    <table class="table table-hover table-bordered mb-0">
        <thead class="table-light">
            <tr>
                <th>Order ID</th>
                <th>Order Date</th>
                <th>Customer ID</th>
                <th>Employee ID</th>
                <th>Outlet ID</th>
                <th>Warehouse ID</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td>@order.CustomerId</td>
                    <td>@order.EmployeeId</td>
                    <td>@order.OutletId</td>
                    <td>@order.WarehouseId</td>
                    <td>
                        <a href="@Url.Action("Details", new { id = order.OrderId })" class="btn btn-sm btn-primary">
                            <i class="fas fa-eye"></i> View
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
