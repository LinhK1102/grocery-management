@model GroceryWebApp.Models.Dto.OrderDetailsViewModel

@{
    ViewData["Title"] = $"Order #{Model.Order.OrderId}";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-receipt me-2"></i>Order Details #@Model.Order.OrderId</h2>
        <a href="/Order/Index" class="btn btn-outline-primary">
            <i class="fas fa-home me-1"></i> Back 
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <p><strong><i class="fas fa-user me-2"></i>Customer:</strong> @Model.CustomerName</p>
            <p><strong><i class="fas fa-user-tie me-2"></i>Employee:</strong> @Model.EmployeeName</p>
            <p><strong><i class="fas fa-store me-2"></i>Outlet:</strong> @Model.OutletName</p>
            <p><strong><i class="fas fa-warehouse me-2"></i>Warehouse:</strong> @Model.WarehouseName</p>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-boxes me-2"></i>Order Items
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th><i class="fas fa-box me-1"></i>Product</th>
                        <th class="text-center"><i class="fas fa-sort-numeric-up me-1"></i>Quantity</th>
                        <th class="text-end"><i class="fas fa-dollar-sign me-1"></i>Unit Price</th>
                        <th class="text-end"><i class="fas fa-percent me-1"></i>Discount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Details)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@item.UnitPriceAtTimeOfSale.ToString("C")</td>
                            <td class="text-end">@item.DiscountApplied.ToString("P")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
