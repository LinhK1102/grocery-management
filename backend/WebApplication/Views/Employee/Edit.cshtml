@model WebApplication.Models.Dto.EmployeeDto
@{
    ViewData["Title"] = "Edit Employee";
}

<h2 class="text-2xl font-bold mb-4">Edit Employee</h2>

<form asp-action="Edit" method="post" class="space-y-4">
    <input type="hidden" asp-for="EmployeeId" />

    <div>
        <label asp-for="EmployeeName" class="block font-medium">Name</label>
        <input asp-for="EmployeeName" class="form-input w-full border rounded px-3 py-2" />
        <span asp-validation-for="EmployeeName" class="text-red-500 text-sm"></span>
    </div>

    <div>
        <label asp-for="EmployeeEmail" class="block font-medium">Email</label>
        <input asp-for="EmployeeEmail" class="form-input w-full border rounded px-3 py-2" />
        <span asp-validation-for="EmployeeEmail" class="text-red-500 text-sm"></span>
    </div>

    <div>
        <label asp-for="EmployeeEmailTokenPass" class="block font-medium">Email Token</label>
        <input asp-for="EmployeeEmailTokenPass" class="form-input w-full border rounded px-3 py-2" />
        <span asp-validation-for="EmployeeEmailTokenPass" class="text-red-500 text-sm"></span>
    </div>

    <div>
        <label asp-for="RetailOutletId" class="block font-medium">Retail Outlet ID</label>
        <input asp-for="RetailOutletId" type="number" class="form-input w-full border rounded px-3 py-2" />
        <span asp-validation-for="RetailOutletId" class="text-red-500 text-sm"></span>
    </div>

    <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded">Save Changes</button>
    <a asp-action="Index" class="ml-4 text-gray-600 hover:underline">Back to List</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
