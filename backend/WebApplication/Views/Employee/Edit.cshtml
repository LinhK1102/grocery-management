@model GroceryWebApp.Models.Dto.EmployeeDto
@{
    ViewData["Title"] = "Edit Employee";
}

<div class="container mt-5">
    <h2 class="mb-4 fw-bold">Edit Employee</h2>

    <form asp-action="Edit" asp-route-id="@Model.EmployeeId" method="post">
        <input type="hidden" asp-for="EmployeeId" />

        <div class="mb-3">
            <label asp-for="EmployeeName" class="form-label">Name</label>
            <input asp-for="EmployeeName" class="form-control" />
            <span asp-validation-for="EmployeeName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EmployeeEmail" class="form-label">Email</label>
            <input asp-for="EmployeeEmail" class="form-control" />
            <span asp-validation-for="EmployeeEmail" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RetailOutletId" class="form-label">Retail Outlet</label>
            @Html.DropDownListFor(model => model.RetailOutletId,
                     ViewBag.RetailOutletList as List<SelectListItem>,
                     "-- Select Outlet --",
                     new { @class = "form-select" })
            <span asp-validation-for="RetailOutletId" class="text-danger small"></span>
        </div>

        <div class="d-flex align-items-center gap-3">
            <button type="submit" class="btn btn-success">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
