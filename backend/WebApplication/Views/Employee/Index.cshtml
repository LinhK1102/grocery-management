@model List<GroceryWebApp.Models.Dto.EmployeeDto>
@{
    ViewData["Title"] = "Employee List";
    var outletMap = ViewBag.OutletMap as Dictionary<int, string>;
}

<div class="container mt-5">
    <h1 class="mb-4 fw-bold">Employee List</h1>

    <div class="mb-3 text-end">
        <a href="@Url.Action("Create")" class="btn btn-primary">
            + Add Employee
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover  align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Retail Outlet</th>
                    <th scope="col" style="width: 160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in Model)
                {
                    <tr>
                        <td>@emp.EmployeeId</td>
                        <td>@emp.EmployeeName</td>
                        <td>@emp.EmployeeEmail</td>
                        <td>@(outletMap.ContainsKey(emp.RetailOutletId) ? outletMap[emp.RetailOutletId] : "N/A")</td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = emp.EmployeeId })" class="btn btn-sm btn-outline-primary me-2">
                                Edit
                            </a>
                            <form asp-action="DeleteConfirmed" asp-route-id="@emp.EmployeeId" method="post" class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this employee?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
