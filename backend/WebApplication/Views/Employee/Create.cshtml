@model BusinessObjects.DTOs.EmployeeRegisterRequest
@{
    ViewData["Title"] = "Create Employee";
}

<div class="container card">
    <div class="card-header bg-primary text-white">
        <h4>Create New Employee</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post" novalidate>
            <div class="mb-3">
                <label asp-for="EmployeeName" class="form-label">Full Name</label>
                <input asp-for="EmployeeName" class="form-control" />
                <span asp-validation-for="EmployeeName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" type="password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left-circle me-1"></i> Back to List
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-person-plus-fill me-1"></i> Create
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
