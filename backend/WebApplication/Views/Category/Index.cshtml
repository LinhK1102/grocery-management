@using WebApplication.Models.Dto
@model List<CategoryDto>
@{
    ViewData["Title"] = "Category List";
}
<h2>Categories</h2>
<div class="container mt-4">
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <!-- Placeholder ảnh -->
                    <div class="card-img-top bg-light" style="height: 150px; display: flex; align-items: center; justify-content: center;">
                        <span class="text-muted">[Image Here]</span>
                    </div>

                    <div class="card-body">
                        <h5 class="card-title text-center text-uppercase">@item.CategoryName</h5>
                    </div>

                    <div class="card-footer text-center bg-white border-0 pb-3">
                        <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-outline-primary btn-sm">View More</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

