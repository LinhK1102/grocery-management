@model WebApplication.Models.Dto.CategoryDto

@{
    var isCreate = Model.CategoryId == 0;
    ViewData["Title"] = isCreate ? "Create Category" : "Edit Category";
    var formAction = isCreate ? "Create" : "Edit";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="@formAction" method="post">
    <div class="form-group">
        <label asp-for="CategoryName" class="form-label"></label>
        <input asp-for="CategoryName" class="form-control" />
        <span asp-validation-for="CategoryName" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
