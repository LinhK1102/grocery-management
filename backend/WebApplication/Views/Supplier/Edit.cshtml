@model GroceryWebApp.Models.Dto.SupplierDto
@{
    ViewData["Title"] = "Edit Supplier";
}

<div class="container mt-5">
    <h2 class="mb-4 fw-bold">Edit Supplier</h2>

    <form asp-action="Edit" asp-route-id="@Model.SupplierId" method="post" class="needs-validation" novalidate>
        <input type="hidden" asp-for="SupplierId" />

        <div class="mb-3">
            <label asp-for="SupplierName" class="form-label">Name</label>
            <input asp-for="SupplierName" class="form-control" />
            <span asp-validation-for="SupplierName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SupplierEmail" class="form-label">Email</label>
            <input asp-for="SupplierEmail" class="form-control" />
            <span asp-validation-for="SupplierEmail" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SupplierPhoneNumber" class="form-label">Phone Number</label>
            <input asp-for="SupplierPhoneNumber" class="form-control" />
            <span asp-validation-for="SupplierPhoneNumber" class="text-danger small"></span>
        </div>

        <div class="d-flex align-items-center gap-3">
            <button type="submit" class="btn btn-success">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
