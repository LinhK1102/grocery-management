@using static GroceryWebApp.Constants.SystemMessages
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GroceryWebApp</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GroceryWebApp.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="d-flex">
        <!-- Sidebar (desktop only) -->
        <aside class="d-none d-md-flex flex-column bg-light shadow p-3" style="width: 16rem; min-height: 100vh;">
            @await Html.PartialAsync("_Sidebar")
        </aside>

        <!-- Main layout -->
        <div class="flex-grow-1">
            <!-- Header -->
            <header class="position-sticky top-0 z-3 py-2 px-3 px-md-4">
                @await Html.PartialAsync("_Header")
            </header>

            <!-- Content -->
            <main class="p-3 p-md-4">
                <div class="bg-white rounded-4 shadow-lg p-4 transition-float">

                    @RenderBody()
                </div>
            </main>

            <!-- Footer -->
            <footer class="border-top text-muted text-center py-3 px-3 px-md-4">
                &copy; 2025 - GroceryWebApp - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <!-- Mobile Sidebar -->
    <div class="offcanvas offcanvas-start d-md-none" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="mobileSidebarLabel">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            @await Html.PartialAsync("_Sidebar")
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="https://unpkg.com/@@zxing/library@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

    @section Scripts {
        <script>
                const connection = new signalR.HubConnectionBuilder()
                .withUrl("http://localhost:5100/notificationHub") // URL API
                .build();

            connection.on("ReceiveNotification", function (message) {
                const alert = document.createElement("div");
                alert.className = "alert alert-info position-fixed top-0 end-0 m-4 shadow";
                alert.innerHTML = `<i class="bi bi-info-circle me-2"></i>${message}`;
                document.body.appendChild(alert);
                setTimeout(() => alert.remove(), 5000);
            });

            connection.start().catch(err => console.error(err));

            $(function () {
                $('.select2').select2({
                    placeholder: 'Select an option',
                    allowClear: true,
                    width: '100%'
                });
            });

                 function closeStatusModal() {
                document.getElementById('statusModal')?.remove();
                document.getElementById('modalBackdrop')?.remove();
            }
            setTimeout(closeStatusModal, 5000);
        </script>
    }

</body>
</html>
