@using static WebApplication.Constants.SystemMessages
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApplication</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons (local + CDN fallback) -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication.styles.css" asp-append-version="true" />

    @* icon font awesome *@
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

</head>
<body class="bg-light">
    <div class="d-flex">
        <!-- Sidebar (desktop only) -->
        <aside class="d-none d-md-flex flex-column bg-light shadow p-3" style="width: 16rem; min-height: 100vh;">
            @await Html.PartialAsync("_Sidebar")
        </aside>

        <!-- Main layout -->
        <div class="flex-grow-1">
            <!-- Header -->
            <header class="position-sticky top-0 z-3 py-2 px-3 px-md-4" style="margin-left: 0rem;">
                @await Html.PartialAsync("_Header")
            </header>

            <!-- Content area -->
            <main class="p-3 p-md-4" style="margin-left: 0;">
                <div class="bg-white rounded-4 shadow-lg p-4 transition-float">
                    @RenderBody()
                </div>
            </main>

            <!-- Footer -->
            <footer class="border-top text-muted text-center py-3 px-3 px-md-4">
                &copy; 2025 - WebApplication - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <!-- Mobile Sidebar -->
    <div class="offcanvas offcanvas-start d-md-none" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="mobileSidebarLabel">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            @await Html.PartialAsync("_Sidebar")
        </div>
    </div>

    <!-- Scripts -->

    <!-- Load jQuery + Bootstrap -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Select2 CSS & JS (chỉ cần 1 lần ở layout) -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- Custom site-wide JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)


    @* @section Scripts { *@
    @*     <script> *@
    @*         $(document).ready(function () { *@
    @*             $('.select2').select2({ *@
    @*                 placeholder: 'Select an option', *@
    @*                 allowClear: true, *@
    @*                 width: '100%' *@
    @*             }); *@
    @*         }); *@
    @*     </script> *@
    @* } *@

    @if (TempData[StatusConstants.TempDataStatus] is string status && TempData[StatusConstants.TempDataMessage] is string message)
    {
        var icon = status == StatusConstants.Success ? "bi-check-circle-fill" : "bi-x-circle-fill";
        var alertClass = status == StatusConstants.Success ? "success" : "danger";
        <div class="modal fade show" id="statusModal" tabindex="-1" style="display: block;" aria-modal="true" role="dialog">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow rounded-4">
                    <div class="modal-header bg-light">
                        <h5 class="modal-title">Status</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                                onclick="document.getElementById('statusModal').style.display = 'none'; document.body.classList.remove('modal-open'); document.querySelector('.modal-backdrop')?.remove();">
                        </button>
                    </div>
                    <div class="modal-body text-center">
                        <div class="alert alert-@alertClass mb-0">
                            <i class="bi @icon me-2"></i> @message
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

</body>
</html>
