@using static GroceryWebApp.Constants.SystemMessages
<!DOCTYPE html>
<html lang="en">
<!-- Head -->
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GroceryWebApp</title>

    <!-- Local Bootstrap CSS -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Font Awesome (CDN) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Select2 CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-light">
    <div class="d-flex">
        <!-- Sidebar (desktop only) -->
        <aside class="d-none d-md-flex flex-column bg-light shadow p-3" style="width: 16rem; min-height: 100vh;">
            @await Html.PartialAsync("_Sidebar")
        </aside>

        <!-- Main layout -->
        <div class="flex-grow-1">
            <!-- Header -->
            <header class="position-sticky top-0 z-3 py-2 px-3 px-md-4">
                @await Html.PartialAsync("_Header")
            </header>

            <!-- Content -->
            <main class="p-3 p-md-4">
                <div class="bg-white rounded-4 shadow-lg p-4 transition-float">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    @RenderBody()
                </div>
            </main>

            <!-- Footer -->
            <footer class="border-top text-muted text-center py-3 px-3 px-md-4">
                &copy; 2025 - GroceryWebApp - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <!-- Mobile Sidebar -->
    <div class="offcanvas offcanvas-start d-md-none" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="mobileSidebarLabel">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            @await Html.PartialAsync("_Sidebar")
        </div>
    </div>
    <!-- Toast Container -->
    <div class="toast-container position-fixed top-0 end-0 p-3 z-3" style="z-index: 9999">
    </div>

    <!-- Local JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

    <!-- CDN Libraries (SignalR phải load trước các file cần dùng nó) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="~/js/signalr-notify.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://unpkg.com/@@zxing/library@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>


    @RenderSection("Scripts", required: false)

    <!-- Custom Script -->
    <script>
        console.log("Controller: @ViewContext.RouteData.Values["controller"], Action: @ViewContext.RouteData.Values["action"]");

        $(function () {
            $('.select2').select2({
                placeholder: 'Select an option',
                allowClear: true,
                width: '100%'
            });
        });

        function closeStatusModal() {
            document.getElementById('statusModal')?.remove();
            document.getElementById('modalBackdrop')?.remove();
        }

        setTimeout(closeStatusModal, 5000);
    </script>


</body>
</html>
