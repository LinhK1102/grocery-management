<header class="bg-white border border-light shadow-sm d-flex align-items-center justify-content-center px-3 px-md-4 rounded-4 mx-3 mt-3"
        style="min-height: 4.5rem;">
    <div class="container-fluid d-flex align-items-center justify-content-between px-0">
        <!-- Left: Hamburger + Brand -->
        <div class="d-flex align-items-center">
            <!-- Hamburger -->
            <button class="btn me-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
                <i class="bi bi-list fs-3"></i>
            </button>

            <!-- Brand -->
            <a class="navbar-brand fw-bold text-primary d-flex align-items-center m-0" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shop me-2 fs-4"></i> WebApp
            </a>
        </div>

        <!-- Center: Search -->
        <form class="d-none d-lg-flex flex-grow-1 mx-4" method="get" action="/Search/Result">
            <div class="input-group w-100">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input class="form-control" type="search" name="q" placeholder="Search..." required />
                <button class="btn btn-outline-primary" type="submit">Search</button>
            </div>
        </form>

        <!-- Right: User Dropdown -->
        <div class="dropdown">
            <a href="#" class="d-block link-dark text-decoration-none dropdown-toggle" id="dropdownUser"
               data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-user-tie fa-2x rounded-circle bg-secondary text-white p-2 shadow"></i>
            </a>

            <ul class="dropdown-menu dropdown-menu-end text-small" aria-labelledby="dropdownUser">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                        </a>
                    </li>
                }
                else
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Login
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</header>
