<div class="d-flex flex-column bg-light shadow-sm" style="width: 250px; height: 100vh; position: fixed; padding: 1.5rem;">
    <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center mb-4 text-dark text-decoration-none">
        <i class="bi bi-basket-fill fs-3 me-2 text-success"></i>
        <span class="fs-4 fw-bold">Grocery Admin</span>
    </a>

    <hr />

    <ul class="nav nav-pills flex-column mb-auto gap-1">
        <li class="nav-item">
            <a asp-controller="Home" asp-action="Index"
               class="nav-link d-flex align-items-center @((ViewContext.RouteData.Values["controller"]?.ToString() == "Home") ? "active text-white bg-primary" : "text-dark")">
                <i class="bi bi-house-door me-2"></i> Dashboard
            </a>
        </li>

        <li class="mt-3">
            <strong class="text-muted text-uppercase small">Management</strong>
        </li>

        <li>
            <a asp-controller="Product" asp-action="Index" class="nav-link d-flex align-items-center text-dark">
                <i class="bi bi-box me-2"></i> Products
            </a>
        </li>

        <li>
            <a asp-controller="Category" asp-action="Index" class="nav-link d-flex align-items-center text-dark">
                <i class="bi bi-tags me-2"></i> Categories
            </a>
        </li>

        <li>
            <a asp-controller="Supplier" asp-action="Index" class="nav-link d-flex align-items-center text-dark">
                <i class="bi bi-truck me-2"></i> Suppliers
            </a>
        </li>

        @* <li> *@
        @*     <a asp-controller="Customer" asp-action="Index" class="nav-link text-dark"> *@
        @*         <i class="bi bi-people me-1"></i> Customers *@
        @*     </a> *@
        @* </li> *@

        <li>
            <a asp-controller="Employee" asp-action="Index" class="nav-link d-flex align-items-center text-dark">
                <i class="bi bi-person-badge me-2"></i> Employees
            </a>
        </li>

        <li>
            <a asp-controller="Warehouse" asp-action="Index" class="nav-link d-flex align-items-center text-dark">
                <i class="bi bi-building me-2"></i> Warehouses
            </a>
        </li>

        <li class="mt-3">
            <strong class="text-muted text-uppercase small">Orders</strong>
        </li>

        <li>
            <a asp-controller="Order" asp-action="Index" class="nav-link d-flex align-items-center text-dark">
                <i class="bi bi-receipt me-2"></i> Orders
            </a>
        </li>

        @if (User.IsInRole("Employee"))
        {
            <li class="mt-2">
                <a asp-controller="Order" asp-action="Create" class="btn btn-success w-100 d-flex align-items-center justify-content-center">
                    <i class="bi bi-plus-circle me-2"></i> Create Order
                </a>
            </li>

            <li class="mt-2">
                <a asp-controller="Barcode" asp-action="Scan" class="btn btn-outline-info w-100 d-flex align-items-center justify-content-center">
                    <i class="fas fa-barcode me-2"></i> Scan Barcode
                </a>
            </li>
        }

        @if (User.IsInRole("Admin"))
        {
            <li class="mt-4">
                <strong class="text-muted text-uppercase small">Admin Panel</strong>
            </li>

            <li>
                <a asp-controller="Employee" asp-action="Index" class="nav-link d-flex align-items-center text-dark">
                    <i class="bi bi-person-lines-fill me-2"></i> Account Management
                </a>
            </li>

            <li>
                <a asp-controller="Report" asp-action="Index" class="nav-link d-flex align-items-center text-dark">
                    <i class="bi bi-bar-chart-line me-2"></i> Reports
                </a>
            </li>
        }

        <li class="mt-4">
            <form action="/logout" method="post">
                <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </button>
            </form>
        </li>
    </ul>
</div>
