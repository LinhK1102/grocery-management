﻿<div class="d-flex flex-column p-3 bg-light shadow" style="width: 250px; height: 100vh; position: fixed;">
    <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center mb-3 text-dark text-decoration-none">
        <span class="fs-4 fw-bold">Grocery Admin</span>
    </a>
    <hr />
    <ul class="nav nav-pills flex-column mb-auto">
        <li class="nav-item">
            <a asp-controller="Home" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active text-white bg-primary" : "text-dark")">
                <i class="bi bi-house-door me-1"></i> Dashboard
            </a>
        </li>

        <li class="mt-2"><strong class="text-muted">Management</strong></li>

        <li>
            <a asp-controller="Product" asp-action="Index" class="nav-link text-dark">
                <i class="bi bi-box me-1"></i> Products
            </a>
        </li>
        <li>
            <a asp-controller="Category" asp-action="Index" class="nav-link text-dark">
                <i class="bi bi-tags me-1"></i> Categories
            </a>
        </li>
        <li>
            <a asp-controller="Supplier" asp-action="Index" class="nav-link text-dark">
                <i class="bi bi-truck me-1"></i> Suppliers
            </a>
        </li>
        @* <li> *@
        @*     <a asp-controller="Customer" asp-action="Index" class="nav-link text-dark"> *@
        @*         <i class="bi bi-people me-1"></i> Customers *@
        @*     </a> *@
        @* </li> *@
        <li>
            <a asp-controller="Employee" asp-action="Index" class="nav-link text-dark">
                <i class="bi bi-person-badge me-1"></i> Employees
            </a>
        </li>
        <li>
            <a asp-controller="Warehouse" asp-action="Index" class="nav-link text-dark">
                <i class="bi bi-building me-1"></i> Warehouses
            </a>
        </li>
        <li>
            <a asp-controller="Item" asp-action="Index" class="nav-link text-dark">
                <i class="bi bi-upc-scan me-1"></i> Inventory Items
            </a>
        </li>

        <li class="mt-2"><strong class="text-muted">Orders</strong></li>

        <li>
            <a asp-controller="Order" asp-action="Index" class="nav-link text-dark">
                <i class="bi bi-receipt me-1"></i> Orders
            </a>
        </li>
        <li>
            <a asp-controller="OrderDetail" asp-action="Index" class="nav-link text-dark">
                <i class="bi bi-card-list me-1"></i> Order Details
            </a>
        </li>
        <li>
            <a asp-controller="Invoice" asp-action="Index" class="nav-link text-dark">
                <i class="bi bi-file-earmark-text me-1"></i> Invoices
            </a>
        </li>
        @if (User.IsInRole("Employee"))
        {
            <li class="mt-2">
                <a asp-controller="Order" asp-action="Create" class="btn btn-success w-100">
                    <i class="bi bi-plus-circle me-1"></i> Create Order
                </a>
            </li>
        }

        @if (User.IsInRole("Admin"))
        {
            <li class="mt-3"><strong class="text-muted">Admin Panel</strong></li>

            <li>
                <a asp-controller="Account" asp-action="Index" class="nav-link text-dark">
                    <i class="bi bi-person-lines-fill me-1"></i> Account Management
                </a>
            </li>
            <li>
                <a asp-controller="Report" asp-action="Index" class="nav-link text-dark">
                    <i class="bi bi-bar-chart-line me-1"></i> Reports
                </a>
            </li>
            <li>
                <a asp-controller="System" asp-action="Settings" class="nav-link text-dark">
                    <i class="bi bi-gear me-1"></i> System Settings
                </a>
            </li>
        }

        <li class="mt-3">
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-danger w-100">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </button>
            </form>
        </li>
    </ul>
